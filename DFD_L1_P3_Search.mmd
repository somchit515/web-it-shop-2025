flowchart TB
    classDef actor   fill:#1e1b4b,stroke:#6366f1,stroke-width:2px,color:#c7d2fe
    classDef process fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#a7f3d0,font-weight:bold
    classDef store   fill:#1c1917,stroke:#78716c,stroke-width:2px,color:#d6d3d1
    classDef svc     fill:#431407,stroke:#f97316,stroke-width:2px,color:#fed7aa

    %% ══════════════════════════════════════════════════
    %%  EXTERNAL ENTITIES
    %% ══════════════════════════════════════════════════
    CUST["👤 ລູກຄ້າ"]
    AUTH["🔐 2.0 Auth Middleware"]
    CART["🛒 5.0 Cart / Order"]

    %% ══════════════════════════════════════════════════
    %%  DATA STORES
    %% ══════════════════════════════════════════════════
    D1[("D1 · Products")]
    D2[("D2 · Categories")]
    D3[("D3 · FlashDeal")]

    %% ══════════════════════════════════════════════════
    %%  SUB-PROCESSES
    %% ══════════════════════════════════════════════════
    P31("3.1\nຄົ້ນຫາ Keyword\nKeyword Search")
    P32("3.2\nກັ່ນຕອງ & ຈັດລຳດັບ\nFilter & Sort")
    P33("3.3\nສະແດງ ໝວດໝູ່\nCategory Browse")
    P34("3.4\nສະແດງ Flash Deal\nFlash Deal")
    P35("3.5\nລາຍລະອຽດ ສິນຄ້າ\nProduct Detail")
    P36("3.6\nຂຽນ & ເບິ່ງ Review\nReview")

    %% ══════════════════════════════════════════════════
    %%  3.1 ຄົ້ນຫາ Keyword
    %% ══════════════════════════════════════════════════
    CUST -->|"keyword"| P31
    D1   -->|"ສິນຄ້າທັງໝົດ (name, desc)"| P31
    P31  -->|"ຜົນຄົ້ນຫາ (ຊື່, ລາຄາ, ຮູບ)"| CUST

    %% ══════════════════════════════════════════════════
    %%  3.2 ກັ່ນຕອງ & ຈັດລຳດັບ
    %% ══════════════════════════════════════════════════
    CUST -->|"ລາຄາ min/max + ຄະແນນ + sort"| P32
    D1   -->|"ສິນຄ້າ ກົງເງື່ອນໄຂ"| P32
    P32  -->|"ລາຍການ ທີ່ກັ່ນຕອງ + ຈຳນວນ"| CUST

    %% ══════════════════════════════════════════════════
    %%  3.3 ສະແດງ ໝວດໝູ່
    %% ══════════════════════════════════════════════════
    CUST -->|"ໝວດໝູ່ / slug"| P33
    D2   -->|"ໝວດໝູ່ + img + slug"| P33
    D1   -->|"ສິນຄ້າ ໃນໝວດ"| P33
    P33  -->|"ໝວດໝູ່ + ລາຍການ ສິນຄ້າ"| CUST

    %% ══════════════════════════════════════════════════
    %%  3.4 ສະແດງ Flash Deal
    %% ══════════════════════════════════════════════════
    D3   -->|"Flash Deal ທີ່ active (endsAt, discount%)"| P34
    D1   -->|"ລາຍລະອຽດ ສິນຄ້າ Flash"| P34
    P34  -->|"ສິນຄ້າ + Countdown + ລາຄາ ຫຼຸດ"| CUST

    %% ══════════════════════════════════════════════════
    %%  3.5 ລາຍລະອຽດ ສິນຄ້າ
    %% ══════════════════════════════════════════════════
    CUST -->|"Product ID"| P35
    D1   -->|"ຂໍ້ມູນ ສິນຄ້າ + stock + images"| P35
    D3   -->|"Flash Deal (ຖ້າ product ຢູ່ໃນ deal)"| P35
    P35  -->|"ລາຍລະອຽດ + ຮູບ + stock + avg rating"| CUST
    P35  -->|"Product ID + ລາຄາ"| CART

    %% ══════════════════════════════════════════════════
    %%  3.6 ຂຽນ & ເບິ່ງ Review
    %% ══════════════════════════════════════════════════
    CUST -->|"rating (1–5) + ຄຳຄິດເຫັນ"| P36
    AUTH -->|"req.user + ກວດ Delivered Order"| P36
    D1   -->|"reviews[] + avg rating"| P36
    P36  -->|"ບັນທຶກ Review + ຄຳນວນ avg rating"| D1
    P36  -->|"ລາຍການ Review + avg"| CUST

    %% ══════════════════════════════════════════════════
    %%  Apply Styles
    %% ══════════════════════════════════════════════════
    class CUST,AUTH,CART actor
    class P31,P32,P33,P34,P35,P36 process
    class D1,D2,D3 store
