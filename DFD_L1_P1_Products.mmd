flowchart TB
    classDef actor   fill:#1e1b4b,stroke:#6366f1,stroke-width:2px,color:#c7d2fe
    classDef process fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#a7f3d0,font-weight:bold
    classDef store   fill:#1c1917,stroke:#78716c,stroke-width:2px,color:#d6d3d1
    classDef svc     fill:#431407,stroke:#f97316,stroke-width:2px,color:#fed7aa

    %% ══════════════════════════════════════════════════
    %%  EXTERNAL ENTITIES
    %% ══════════════════════════════════════════════════
    ADMIN["🛠️ Admin"]
    CUST["👤 ລູກຄ້າ"]
    ORDER_P["📦 2.0 ລະບົບ Order"]
    CLOUD["☁️ Cloudinary"]

    %% ══════════════════════════════════════════════════
    %%  DATA STORES
    %% ══════════════════════════════════════════════════
    D1[("D1 · Products")]
    D2[("D2 · Categories")]
    D3[("D3 · FlashDeal")]

    %% ══════════════════════════════════════════════════
    %%  SUB-PROCESSES
    %% ══════════════════════════════════════════════════
    P11("1.1\nເພີ່ມສິນຄ້າໃໝ່")
    P12("1.2\nອັບເດດສິນຄ້າ")
    P13("1.3\nລຶບສິນຄ້າ")
    P14("1.4\nຄົ້ນຫາ & ກັ່ນຕອງ")
    P15("1.5\nກວດ Stock")
    P16("1.6\nຈັດການ Flash Deal")
    P17("1.7\nຈັດການ Review")
    P18("1.8\nອັບໂຫຼດຮູບພາບ")

    %% ══════════════════════════════════════════════════
    %%  1.1 ເພີ່ມສິນຄ້າໃໝ່
    %% ══════════════════════════════════════════════════
    ADMIN -->|"ຊື່, ລາຄາ, ລາຍລະອຽດ, ໝວດ, stock"| P11
    D2    -->|"ລາຍຊື່ໝວດໝູ່ທີ່ມີ"| P11
    P11   -->|"ບັນທຶກ Product ໃໝ່"| D1

    %% ══════════════════════════════════════════════════
    %%  1.2 ອັບເດດສິນຄ້າ
    %% ══════════════════════════════════════════════════
    ADMIN -->|"Product ID + ຂໍ້ມູນໃໝ່"| P12
    D1    -->|"ຂໍ້ມູນສິນຄ້າປັດຈຸບັນ"| P12
    P12   -->|"ບັນທຶກການປ່ຽນແປງ"| D1

    %% ══════════════════════════════════════════════════
    %%  1.3 ລຶບສິນຄ້າ
    %% ══════════════════════════════════════════════════
    ADMIN -->|"Product ID"| P13
    D1    -->|"ຂໍ້ມູນສິນຄ້າ"| P13
    P13   -->|"ລຶບ Record"| D1

    %% ══════════════════════════════════════════════════
    %%  1.4 ຄົ້ນຫາ & ກັ່ນຕອງ
    %% ══════════════════════════════════════════════════
    CUST -->|"keyword, ໝວດ, ລາຄາ, rating"| P14
    D1   -->|"ຂໍ້ມູນສິນຄ້າທັງໝົດ"| P14
    D2   -->|"ໝວດໝູ່"| P14
    D3   -->|"Flash Deal ທີ່ active"| P14
    P14  -->|"ລາຍການສິນຄ້າທີ່ກົງ"| CUST

    %% ══════════════════════════════════════════════════
    %%  1.5 ກວດ Stock
    %% ══════════════════════════════════════════════════
    ORDER_P -->|"Order Items (productId, qty)"| P15
    D1      -->|"ຈຳນວນ Stock ປັດຈຸບັນ"| P15
    P15     -->|"ຫຼຸດ Stock (atomic)"| D1
    P15     -->|"ຜົນກວດ: OK / ບໍ່ພໍ / ໝົດ"| ORDER_P

    %% ══════════════════════════════════════════════════
    %%  1.6 ຈັດການ Flash Deal
    %% ══════════════════════════════════════════════════
    ADMIN -->|"ສິນຄ້າທີ່ເລືອກ + Discount%"| P16
    D1    -->|"ລາຍລະອຽດສິນຄ້າ"| P16
    D3    -->|"Flash Deal ເກົ່າ"| P16
    P16   -->|"ບັນທຶກ / ອັບເດດ Flash Deal"| D3
    P16   -->|"Flash Deal ທີ່ active"| CUST

    %% ══════════════════════════════════════════════════
    %%  1.7 ຈັດການ Review
    %% ══════════════════════════════════════════════════
    CUST  -->|"rating (1-5) + ຄຳຄິດເຫັນ"| P17
    ADMIN -->|"ລຶບ Review"| P17
    D1    -->|"ຂໍ້ມູນ Product + Reviews"| P17
    P17   -->|"ບັນທຶກ Review + ຄຳນວນ avg rating"| D1
    P17   -->|"Review ທີ່ post ສຳເລັດ"| CUST

    %% ══════════════════════════════════════════════════
    %%  1.8 ອັບໂຫຼດຮູບພາບ
    %% ══════════════════════════════════════════════════
    ADMIN  -->|"ໄຟລ໌ຮູບ (Product / Avatar / Proof)"| P18
    P18    -->|"Upload to Cloudinary"| CLOUD
    CLOUD  -->|"URL + public_id"| P18
    P18    -->|"ບັນທຶກ images[]"| D1

    %% ══════════════════════════════════════════════════
    %%  Apply Styles
    %% ══════════════════════════════════════════════════
    class ADMIN,CUST,ORDER_P actor
    class P11,P12,P13,P14,P15,P16,P17,P18 process
    class D1,D2,D3 store
    class CLOUD svc
